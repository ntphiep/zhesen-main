{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "git": { "deploymentEnabled": { "master": false } },
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [{ "type": "host", "value": { "eq": "zhesen-main.vercel.app" } }],
      "destination": "https://zhesen.net/:path",
      "permanent": true
    }
  ]
}
