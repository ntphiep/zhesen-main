NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The origin used for canonical URLs, the sitemap and robots.txt. Only needed if
# the site moves off the domain written into lib/site.ts; the build that produces
# the deployment cannot read VERCEL_PROJECT_PRODUCTION_URL. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# Shared secret for POST /api/revalidate, which clears the server-side search cache
# after the pipeline loads new data.
REVALIDATE_SECRET=

# Set to 1 only when a proxy in front of the app overwrites x-forwarded-for. Left
# unset, the header is ignored: a client can write whatever it likes into it, and
# trusting it made the per-address rate limit free to bypass. Not needed on Vercel,
# which overwrites the header itself and is detected through VERCEL=1. See
# lib/http/rateLimit.ts.
TRUST_PROXY_HEADER=

# How many queries the search cache has never seen may reach Supabase per minute.
# Defaults to 180. Lower it to exercise the limit locally; raise it on a deployment
# that can serve more.
COLD_QUERIES_PER_MINUTE=

# Optional assistant. Left unset, /api/ai answers {"enabled": false} and every
# assistant button stays off the page. An Anthropic-compatible endpoint including
# the version segment, e.g. http://host:port/v1. Server-only: never NEXT_PUBLIC_.
AI_BASE_URL=
AI_API_KEY=
# Defaults to ag/gemini-3.8-flash when unset.
AI_MODEL=
