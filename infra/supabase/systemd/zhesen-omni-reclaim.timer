# Every minute: under the batch jobs the cgroup climbed from 764 MB to 1,251 MB between two runs
# 2 minutes apart (2026-10-06), and the guard trips at 1,288 MB of the 1,400 MB limit.
[Unit]
Description=Reclaim OmniRoute page cache every minute

[Timer]
OnCalendar=minutely
AccuracySec=5s

[Install]
WantedBy=timers.target
