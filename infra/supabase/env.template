############
# Template for the .env that bin/render-env.sh writes on the instance, mode 0600.
# Every SSM placeholder is replaced with that parameter's value; a missing
# parameter aborts the render. No secret value belongs in this file.
############

COMPOSE_FILE=docker-compose.yml

############
# Secrets, from SSM Parameter Store
############

POSTGRES_PASSWORD=${SSM:/zhesen/prod/postgres_password}

# Created by hand and not managed by Terraform. The anon and service_role keys
# are HS256 JWTs signed by this secret; Envoy compares the apikey header against
# them by string equality, so they must stay the exact Cloud strings.
JWT_SECRET=${SSM:/zhesen/prod/jwt_secret}
ANON_KEY=${SSM:/zhesen/prod/anon_key}
SERVICE_ROLE_KEY=${SSM:/zhesen/prod/service_role_key}

DASHBOARD_USERNAME=${SSM:/zhesen/prod/dashboard_username}
DASHBOARD_PASSWORD=${SSM:/zhesen/prod/dashboard_password}
PG_META_CRYPTO_KEY=${SSM:/zhesen/prod/pg_meta_crypto_key}

# The 9router dashboard's password, shown on /admin/router.
ROUTER_PASSWORD=${SSM:/zhesen/prod/router_password}

# OmniRoute's dashboard password, and the key its provider logins are encrypted with.
OMNIROUTE_PASSWORD=${SSM:/zhesen/prod/omniroute_password}
OMNIROUTE_STORAGE_KEY=${SSM:/zhesen/prod/omniroute_storage_key}

# The review reminder's VAPID pair (issue #91), created by hand: a new pair orphans every
# browser subscription. The public half is also Vercel's NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=${SSM:/zhesen/prod/vapid_public_key}
VAPID_PRIVATE_KEY=${SSM:/zhesen/prod/vapid_private_key}

# Nothing in this compose file reads these two. They are rendered anyway because
# Terraform generates them and Supavisor or Realtime would need them if added.
SECRET_KEY_BASE=${SSM:/zhesen/prod/secret_key_base}
VAULT_ENC_KEY=${SSM:/zhesen/prod/vault_enc_key}

############
# Legacy API key mode
#
# Left empty on purpose. The browser holds the Cloud anon JWT and the app ships
# it as NEXT_PUBLIC_SUPABASE_ANON_KEY, so switching to sb_publishable_ keys would
# invalidate every session in flight. docker-entrypoint.sh logs
# "Envoy running in legacy API key mode" when these four are empty.
############

SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
JWT_KEYS=
JWT_JWKS=

############
# URLs
############

SUPABASE_PUBLIC_URL=${SSM:/zhesen/prod/public_url}
API_EXTERNAL_URL=${SSM:/zhesen/prod/api_external_url}
SITE_URL=${SSM:/zhesen/prod/site_url}
ADDITIONAL_REDIRECT_URLS=${SSM:/zhesen/prod/additional_redirect_urls}

############
# Database
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# Auth
############

JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=true
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

############
# PostgREST
############

# lex holds the dictionary, admin the gated functions behind /admin (migration
# 0056). This list and the authenticator role's pgrst.db_schemas setting must stay
# in step; the role setting wins when they differ.
PGRST_DB_SCHEMAS=public,graphql_public,lex,admin
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
PGRST_DB_MAX_ROWS=1000

############
# Studio
############

STUDIO_DEFAULT_ORGANIZATION=zhesen
STUDIO_DEFAULT_PROJECT=zhesen
OPENAI_API_KEY=

############
# API gateway
############

API_GW_HTTP_PORT=80
